{
  "name": "coin-bank",
  "version": "2.0.0",
  "description": "Coin Bank — Bitcoin-like digital coin (no real-world value) with public REST API, website, own payment cards and a bilingual (EN/PT) Discord bot.",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./*": "./*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=384 index.js",
    "start:plain": "node index.js",
    "check": "node -e \"require('./lib/config').load(); console.log('config.yml OK')\""
  },
  "keywords": ["discord", "bot", "economy", "coin", "api", "bank"],
  "author": "FoxOficial",
  "license": "Unlicense",
  "dependencies": {
    "discord.js": "^14.22.1",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1",
    "sharp": "^0.34.4"
  }
}
